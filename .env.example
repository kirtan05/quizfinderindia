# Extraction runs through `claude -p` (Claude Code login, no API key)
# EXTRACT_MODEL=sonnet

# Admin
ADMIN_PASSWORD=your-admin-password

# Confidence threshold for auto-publishing
CONFIDENCE_THRESHOLD=0.7

# Instagram (optional — for higher rate limits)
INSTAGRAM_USERNAME=

# Push notifications: the watcher POSTs new quizzes to the site's /api/notify Function.
# Must match the NOTIFY_SECRET secret set on the Pages project (npx wrangler pages secret put NOTIFY_SECRET).
NOTIFY_SECRET=
# SITE_URL=https://quizfinder.pages.dev

# The site is hosted on Cloudflare Pages. The watcher deploys with wrangler, which
# uses the login from `npx wrangler login` (run once in client/), so nothing is needed here.
